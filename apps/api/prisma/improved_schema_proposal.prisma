// 📊 ChronoF1 DB 구조 개선 제안서
// 2025.08.06 - 성능 최적화 및 데이터 동기화 개선

// ==== 🕒 통합 시간 관리 시스템 ====

// 세션별 통합 시간 인덱스 테이블 (신규 제안)
model LiveSessionTimeIndex {
  id                Int           @id @default(autoincrement())
  sessionId         Int           @map("session_id")
  
  // 🔑 핵심: 모든 시간 기준을 하나로 통합
  sequenceNumber    Int           @map("sequence_number") // 0, 1, 2, 3... (1초 간격)
  sessionTime       Float         @map("session_time") // 세션 시작부터 초 (0.0, 1.0, 2.0...)
  absoluteTimestamp DateTime      @map("absolute_timestamp") // 실제 UTC 시간
  relativeTimestamp Int           @map("relative_timestamp") // 세션 시작부터 밀리초
  
  // 메타데이터
  dataAvailable     Boolean       @default(true) @map("data_available") // 해당 시점에 데이터 존재 여부
  primaryDataType   String?       @map("primary_data_type") // LAP, TELEMETRY, POSITION 등
  
  // 관계
  session           CommonSession @relation(fields: [sessionId], references: [id])
  
  @@unique([sessionId, sequenceNumber])
  @@index([sessionId, sessionTime]) // 성능 최적화
  @@index([sessionId, absoluteTimestamp])
  @@map("live_session_time_index")
}

// ==== 🚀 성능 최적화된 데이터 모델 ====

// 통합 라이브 데이터 뷰 테이블 (신규 제안)
model LiveDataSnapshot {
  id                    Int           @id @default(autoincrement())
  sessionId             Int           @map("session_id")
  timeIndexId           Int           @map("time_index_id")
  driverSessionId       Int           @map("driver_session_id")
  
  // 🎯 모든 라이브 데이터를 하나의 레코드로 통합
  // 랩 데이터
  lapNumber             Int?          @map("lap_number")
  currentLapTime        Float?        @map("current_lap_time")
  bestLapTime           Float?        @map("best_lap_time")
  lastLapTime           Float?        @map("last_lap_time")
  sector1Time           Float?        @map("sector1_time")
  sector2Time           Float?        @map("sector2_time")
  sector3Time           Float?        @map("sector3_time")
  sector1Best           Float?        @map("sector1_best")
  sector2Best           Float?        @map("sector2_best")  
  sector3Best           Float?        @map("sector3_best")
  position              Int?          @map("position")
  
  // 텔레메트리 데이터
  speed                 Float?        @map("speed")
  throttle              Float?        @map("throttle")
  brake                 Boolean?      @map("brake")
  gear                  Int?          @map("gear")
  rpm                   Float?        @map("rpm")
  drs                   Int?          @map("drs")
  
  // 포지션 데이터
  posX                  Float?        @map("pos_x")
  posY                  Float?        @map("pos_y")
  posZ                  Float?        @map("pos_z")
  trackStatus           String?       @map("track_status")
  
  // 타이어 데이터
  tyreCompound          String?       @map("tyre_compound")
  tyreAge               Int?          @map("tyre_age")
  
  // 계산된 필드
  gapToLeader           Float?        @map("gap_to_leader")
  gapToAhead            Float?        @map("gap_to_ahead")
  intervalTime          Float?        @map("interval_time")
  
  // 상태 필드
  driverStatus          String?       @map("driver_status") // "On Track", "In Pits", "Out", "Stopped"
  dataQuality          String         @default("GOOD") @map("data_quality") // "GOOD", "INTERPOLATED", "ESTIMATED"
  
  // 관계
  session              CommonSession    @relation(fields: [sessionId], references: [id])
  timeIndex            LiveSessionTimeIndex @relation(fields: [timeIndexId], references: [id])
  driverSession        LiveDriverSession    @relation(fields: [driverSessionId], references: [id])
  
  @@unique([timeIndexId, driverSessionId])
  @@index([sessionId, timeIndexId]) // 시간별 조회 최적화
  @@index([driverSessionId, timeIndexId]) // 드라이버별 조회 최적화
  @@map("live_data_snapshots")
}

// ==== 📈 집계 및 캐시 테이블 ====

// 세션별 통계 캐시 테이블 (신규 제안)
model LiveSessionStats {
  id                    Int           @id @default(autoincrement())
  sessionId             Int           @unique @map("session_id")
  
  // 시간 범위
  startTime             DateTime      @map("start_time")
  endTime               DateTime?     @map("end_time")
  duration              Int?          @map("duration") // 초
  totalLaps             Int?          @map("total_laps")
  
  // 데이터 품질 메트릭
  totalDataPoints       Int           @default(0) @map("total_data_points")
  missingDataPoints     Int           @default(0) @map("missing_data_points")
  interpolatedPoints    Int           @default(0) @map("interpolated_points")
  dataCompleteness      Float?        @map("data_completeness") // 0-100%
  
  // 성능 메트릭
  fastestLap            Float?        @map("fastest_lap")
  fastestLapDriver      String?       @map("fastest_lap_driver")
  averageLapTime        Float?        @map("average_lap_time")
  
  // 최근 업데이트
  lastUpdated           DateTime      @default(now()) @map("last_updated")
  cacheVersion          Int           @default(1) @map("cache_version")
  
  // 관계
  session               CommonSession @relation(fields: [sessionId], references: [id])
  
  @@map("live_session_stats")
}

// ==== 🔧 기존 테이블 개선 제안 ==== 

// LiveLap 테이블 개선
model LiveLapImproved {
  id                    Int             @id @default(autoincrement())
  driverSessionId       Int             @map("driver_session_id")
  lapNumber             Int             @map("lap_number")
  timeIndexId           Int?            @map("time_index_id") // 통합 시간 인덱스 참조
  
  // 🚀 성능 개선: 자주 사용되는 필드만 유지
  lapTime               Float?          @map("lap_time")
  sector1Time           Float?          @map("sector1_time")
  sector2Time           Float?          @map("sector2_time") 
  sector3Time           Float?          @map("sector3_time")
  position              Int?            @map("position")
  
  // 상태 플래그 (boolean으로 최적화)
  isPersonalBest        Boolean?        @map("is_personal_best")
  isValid               Boolean         @default(true) @map("is_valid")
  
  // 관계
  driverSession         LiveDriverSession @relation(fields: [driverSessionId], references: [id])
  timeIndex             LiveSessionTimeIndex? @relation(fields: [timeIndexId], references: [id])
  
  @@unique([driverSessionId, lapNumber])
  @@index([driverSessionId, timeIndexId]) // 시간 기반 조회 최적화
  @@map("live_laps_improved")
}

// LiveTelemetryData 테이블 개선
model LiveTelemetryDataImproved {
  id                    Int             @id @default(autoincrement())
  driverSessionId       Int             @map("driver_session_id")
  timeIndexId           Int             @map("time_index_id") // 통합 시간 인덱스 참조
  
  // ⚡ 핵심 텔레메트리만 유지 (자주 변경되지 않는 필드 제거)
  speed                 Float?          @map("speed")
  throttle              Float?          @map("throttle")
  brake                 Boolean?        @map("brake")
  gear                  Int?            @map("gear")
  rpm                   Float?          @map("rpm")
  drs                   Int?            @map("drs")
  
  // 관계
  driverSession         LiveDriverSession @relation(fields: [driverSessionId], references: [id])
  timeIndex             LiveSessionTimeIndex @relation(fields: [timeIndexId], references: [id])
  
  @@unique([driverSessionId, timeIndexId])
  @@index([timeIndexId]) // 시간별 배치 조회 최적화
  @@map("live_telemetry_data_improved")
}
